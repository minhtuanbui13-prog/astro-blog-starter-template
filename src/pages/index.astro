---
// Import dữ liệu từ index.js
import { shopInfo, products } from '../data/index.js';
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{shopInfo.name} - {shopInfo.slogan}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              vyyRed: '#E31B23',
              vyyRedHover: '#C6151C',
              vyyYellow: '#FFB800',
              vyyBg: '#FFF8F0',
            }
          }
        }
      }
    </script>
  </head>
  <body class="bg-vyyBg text-gray-900 font-sans min-h-screen flex flex-col">

    <!-- Header / Navbar -->
    <header class="bg-vyyRed text-white shadow-md sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
        <div>
          <h1 class="text-2xl font-black tracking-wider uppercase">{shopInfo.name}</h1>
          <p class="text-xs text-yellow-200 hidden sm:block">{shopInfo.slogan}</p>
        </div>
        <div class="flex items-center space-x-3">
          <a href={`tel:${shopInfo.hotline}`} class="bg-vyyYellow text-gray-900 px-3 py-1.5 rounded-full font-bold text-sm hover:bg-yellow-400 transition">
            📞 Hotline: {shopInfo.hotline}
          </a>
        </div>
      </div>
    </header>

    <!-- Hero Banner -->
    <section class="bg-gradient-to-r from-red-600 to-vyyRed text-white py-12 px-4 text-center">
      <div class="max-w-3xl mx-auto">
        <span class="bg-vyyYellow text-gray-900 text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wide">
          Ăn Vặt Đậm Vị - Chill Chuẩn Style
        </span>
        <h2 class="text-3xl md:text-5xl font-extrabold mt-4 mb-3">Thế Giới Chân Gà & Đồ Ăn Vặt Vyy Lady</h2>
        <p class="text-red-100 text-base md:text-lg mb-6">Đậm đà chuẩn vị, giòn ngon sần sật. Giao hàng nhanh chóng tận tay!</p>
        <a href="#products" class="inline-block bg-vyyYellow text-gray-900 font-bold px-6 py-3 rounded-full hover:bg-yellow-400 transition shadow-lg transform hover:-translate-y-0.5">
          Khám phá thực đơn 🔥
        </a>
      </div>
    </section>

    <!-- Product Section -->
    <main id="products" class="max-w-6xl mx-auto px-4 py-10 flex-grow">
      <div class="flex items-center justify-between mb-8 border-b-2 border-red-200 pb-3">
        <h3 class="text-2xl font-bold text-vyyRed flex items-center gap-2">
          <span>🍗</span> Sản Phẩm Nổi Bật
        </h3>
        <span class="text-sm text-gray-500">Chính hãng Vyy Lady</span>
      </div>

      <!-- Product Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {products.map((item) => (
          <div class="bg-white rounded-2xl shadow-sm border border-red-100 overflow-hidden hover:shadow-md transition flex flex-col justify-between">
            <div>
              <!-- Product Image Container -->
              <div class="h-48 bg-red-50 flex items-center justify-center text-6xl relative">
                <span>{item.image}</span>
                {item.tag && (
                  <span class="absolute top-3 left-3 bg-vyyYellow text-gray-900 font-bold text-xs px-2.5 py-1 rounded-full shadow-sm">
                    {item.tag}
                  </span>
                )}
              </div>

              <!-- Content -->
              <div class="p-4">
                <span class="text-xs text-red-500 font-semibold uppercase tracking-wider">{item.category}</span>
                <h4 class="font-bold text-gray-800 text-base mt-1 line-clamp-2">{item.name}</h4>
                <p class="text-gray-500 text-xs mt-2 line-clamp-2">{item.desc}</p>
              </div>
            </div>

            <!-- Price & Button -->
            <div class="p-4 pt-0">
              <div class="flex items-baseline gap-2 mb-3">
                <span class="text-vyyRed font-extrabold text-lg">
                  {item.price.toLocaleString('vi-VN')}đ
                </span>
                {item.originalPrice && (
                  <span class="text-gray-400 text-xs line-through">
                    {item.originalPrice.toLocaleString('vi-VN')}đ
                  </span>
                )}
              </div>
              <button class="w-full bg-vyyRed hover:bg-vyyRedHover text-white font-bold py-2 px-4 rounded-xl text-sm transition">
                Đặt hàng ngay
              </button>
            </div>
          </div>
        ))}
      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white mt-12 border-t-4 border-vyyRed">
      <div class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <h4 class="text-lg font-bold text-vyyYellow mb-2">{shopInfo.name}</h4>
          <p class="text-sm text-gray-400 mb-2">{shopInfo.slogan}</p>
          <p class="text-sm text-gray-300">📍 Địa chỉ: {shopInfo.address}</p>
        </div>
        <div>
          <h4 class="text-base font-bold mb-2 text-white">Liên Hệ Đặt Hàng</h4>
          <p class="text-sm text-gray-300">☎️ Hotline: <span class="text-vyyYellow font-bold">{shopInfo.hotline}</span></p>
          <p class="text-sm text-gray-300">💬 Zalo hỗ trợ: {shopInfo.zalo}</p>
        </div>
        <div>
          <h4 class="text-base font-bold mb-2 text-white">Chính Sách</h4>
          <ul class="text-sm text-gray-400 space-y-1">
            <li>• Giao hàng tận nơi toàn quốc</li>
            <li>• Đảm bảo an toàn vệ sinh thực phẩm</li>
            <li>• Đổi trả nếu sản phẩm lỗi từ NSX</li>
          </ul>
        </div>
      </div>
      <div class="bg-black py-4 text-center text-xs text-gray-500">
        © 2026 {shopInfo.name}. All rights reserved.
      </div>
    </footer>

  </body>
</html>
