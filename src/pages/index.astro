---
// src/pages/index.astro
import data from '../content/index.js';

const { shopInfo, products } = data || {};
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{shopInfo?.name} - {shopInfo?.slogan}</title>

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="https://6a9697843db6a220b86461d0.imgix.net/sandbox/favicon-tbn.png?v=2" />
  <link rel="shortcut icon" href="https://6a9697843db6a220b86461d0.imgix.net/sandbox/favicon-tbn.png?v=2" />
  <link rel="apple-touch-icon" href="https://6a9697843db6a220b86461d0.imgix.net/sandbox/favicon-tbn.png?v=2" />

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background-color: #f8fafc; color: #1e293b; display: flex; flex-direction: column; min-height: 100vh; }
    
    .top-bar { background: #0f172a; color: #fff; font-size: 12px; padding: 8px; text-align: center; }
    .top-bar a { color: #facc15; font-weight: bold; text-decoration: underline; }
    
    header { background: #ffffff; border-bottom: 1px solid #e2e8f0; position: sticky; top: 0; z-index: 50; }
    .header-container { max-width: 1100px; margin: 0 auto; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; }
    .logo { color: #0066ff; font-size: 22px; font-weight: 900; text-transform: uppercase; text-decoration: none; }
    .slogan { font-size: 12px; color: #64748b; }
    .btn-hotline { background: #0066ff; color: #fff; padding: 8px 16px; border-radius: 20px; font-weight: 600; font-size: 14px; text-decoration: none; }
    
    .hero { background: linear-gradient(135deg, #2563eb, #0066ff); color: white; padding: 48px 16px; text-align: center; }
    .hero-badge { background: rgba(255,255,255,0.2); padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600; text-transform: uppercase; border: 1px solid rgba(255,255,255,0.3); }
    .hero h2 { font-size: 32px; font-weight: 800; margin: 16px 0 8px; }
    .hero p { color: #dbeafe; margin-bottom: 24px; }
    .btn-hero { background: #ffffff; color: #0066ff; font-weight: 700; padding: 12px 24px; border-radius: 24px; text-decoration: none; display: inline-block; }
    
    main { max-width: 1100px; margin: 0 auto; padding: 32px 16px; flex-grow: 1; width: 100%; }
    .section-title { font-size: 20px; font-weight: 700; margin-bottom: 24px; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px; display: flex; align-items: center; gap: 8px; }
    .title-bar { width: 8px; height: 20px; background: #0066ff; border-radius: 4px; }
    
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; }
    .card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; padding: 16px; display: flex; flex-direction: column; justify-content: space-between; position: relative; transition: transform 0.2s, box-shadow 0.2s; }
    .card:hover { transform: translateY(-4px); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); }
    
    /* Tag định vị chuẩn ở góc trái */
    .card-tag { position: absolute; top: 24px; left: 24px; background: #0066ff; color: #fff; font-size: 10px; font-weight: 700; padding: 4px 8px; border-radius: 6px; z-index: 10; }
    
    /* Khung chứa ảnh dùng tỷ lệ vuông aspect-ratio */
    .card-img-wrap { 
      width: 100%;
      aspect-ratio: 1 / 1; 
      background: #f8fafc; 
      border-radius: 8px; 
      overflow: hidden; 
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 8px;
    }
    
    /* Hiển thị full ảnh không cắt mất góc */
    .card-img { 
      max-width: 100%; 
      max-height: 100%; 
      width: auto;
      height: auto;
      object-fit: contain; 
      object-position: center;
      transition: transform 0.3s ease; 
    }
    .card:hover .card-img { transform: scale(1.05); }

    .card-category { font-size: 11px; font-weight: 700; color: #0066ff; text-transform: uppercase; }
    .card-title { font-size: 15px; font-weight: 700; margin: 4px 0; color: #0f172a; line-height: 1.3; }
    .card-desc { font-size: 12px; color: #64748b; margin-bottom: 12px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .price-group { display: flex; align-items: baseline; gap: 8px; margin-bottom: 12px; }
    .card-price { font-size: 18px; font-weight: 800; color: #0066ff; }
    .original-price { font-size: 12px; color: #94a3b8; text-decoration: line-through; }
    .btn-buy { background: #0066ff; color: white; border: none; width: 100%; padding: 10px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: background 0.2s; }
    .btn-buy:hover { background: #0052cc; }
    
    footer { background: #0f172a; color: white; margin-top: 40px; border-top: 3px solid #0066ff; }
    .footer-container { max-width: 1100px; margin: 0 auto; padding: 32px 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; }
    .footer-title { color: #0066ff; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; }
    .footer-text { font-size: 13px; color: #94a3b8; line-height: 1.6; }
    .copyright { background: #020617; text-align: center; padding: 12px; font-size: 12px; color: #64748b; }
  </style>
</head>
<body>
  <div class="top-bar">
    🚀 Mua sắm dễ dàng tại <strong>{shopInfo?.name}</strong> - Hotline: <a href={`tel:${shopInfo?.hotline}`}>{shopInfo?.hotline}</a>
  </div>

  <header>
    <div class="header-container">
      <div>
        <a href="#" class="logo">{shopInfo?.name}</a>
        <div class="slogan">{shopInfo?.slogan}</div>
      </div>
      <a href={`tel:${shopInfo?.hotline}`} class="btn-hotline">📞 Hotline: {shopInfo?.hotline}</a>
    </div>
  </header>

  <section class="hero">
    <span class="hero-badge">Trải Nghiệm Mua Sắm Chuẩn Style</span>
    <h2>Thế Giới Snack & Ăn Vặt Vyy Lady</h2>
    <p>Chất lượng cao cấp - Hương vị đậm đà - Giao hàng cực nhanh.</p>
    <a href="#products" class="btn-hero">Xem danh mục sản phẩm 👇</a>
  </section>

  <main id="products">
    <div class="section-title">
      <div class="title-bar"></div>
      Sản Phẩm Nổi Bật ({products?.length || 0})
    </div>
    <div class="grid">
      {products && products.map((item) => (
        <div class="card">
          {item.tag && <span class="card-tag">{item.tag}</span>}
          <div>
            <div class="card-img-wrap">
              <img src={item.image} alt={item.name} class="card-img" loading="lazy" />
            </div>
            <div class="card-category">{item.category}</div>
            <div class="card-title">{item.name}</div>
            <div class="card-desc">{item.desc}</div>
          </div>
          <div>
            <div class="price-group">
              <span class="card-price">{item.price.toLocaleString('vi-VN')}đ</span>
              {item.originalPrice && <span class="original-price">{item.originalPrice.toLocaleString('vi-VN')}đ</span>}
            </div>
            <button class="btn-buy">Liên hệ tư vấn</button>
          </div>
        </div>
      ))}
    </div>
  </main>

  <footer>
    <div class="footer-container">
      <div>
        <div class="footer-title">{shopInfo?.name}</div>
        <div class="footer-text">{shopInfo?.slogan}</div>
        <div class="footer-text">📍 {shopInfo?.address}</div>
      </div>
      <div>
        <div style="font-weight:700; margin-bottom:8px;">Hỗ Trợ Khách Hàng</div>
        <div class="footer-text">☎️ Hotline: <strong style="color:#60a5fa">{shopInfo?.hotline}</strong></div>
        <div class="footer-text">💬 Zalo: {shopInfo?.zalo}</div>
      </div>
      <div>
        <div style="font-weight:700; margin-bottom:8px;">Chính Sách</div>
        <div class="footer-text">• Giao hàng hỏa tốc toàn quốc</div>
        <div class="footer-text">• Kiểm tra hàng trước khi thanh toán</div>
        <div class="footer-text">• Đổi trả trong 7 ngày nếu lỗi từ NSX</div>
      </div>
    </div>
    <div class="copyright">© 2026 {shopInfo?.name}. All rights reserved.</div>
  </footer>
</body>
</html>
