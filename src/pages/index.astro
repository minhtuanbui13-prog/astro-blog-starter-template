---
// Import dữ liệu từ index.js
import { shopInfo, products } from '../data/index.js';
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{shopInfo.name} - {shopInfo.slogan}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brandBlue: '#0066FF',
              brandBlueHover: '#0052CC',
              brandLightBg: '#F8FAFC',
              brandAccentYellow: '#FFB800',
            }
          }
        }
      }
    </script>
  </head>
  <body class="bg-brandLightBg text-gray-800 font-sans min-h-screen flex flex-col">

    <!-- Top Announcement Bar -->
    <div class="bg-gray-900 text-white text-xs py-1.5 px-4 text-center">
      🚀 Mua sắm dễ dàng tại <span class="text-yellow-400 font-bold">{shopInfo.name}</span> - Hotline: <a href={`tel:${shopInfo.hotline}`} class="underline">{shopInfo.hotline}</a>
    </div>

    <!-- Header / Navbar (Nền Trắng - Chữ & Accent Xanh) -->
    <header class="bg-white text-gray-800 shadow-sm sticky top-0 z-50 border-b border-gray-100">
      <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
        <div>
          <h1 class="text-2xl font-black text-brandBlue tracking-tight uppercase">{shopInfo.name}</h1>
          <p class="text-xs text-gray-500 hidden sm:block">{shopInfo.slogan}</p>
        </div>
        <div class="flex items-center space-x-3">
          <a href={`tel:${shopInfo.hotline}`} class="bg-brandBlue text-white px-4 py-2 rounded-full font-semibold text-sm hover:bg-brandBlueHover transition shadow-sm">
            📞 Hotline: {shopInfo.hotline}
          </a>
        </div>
      </div>
    </header>

    <!-- Hero Banner (Tông Xanh - Trắng Sang Trọng) -->
    <section class="bg-gradient-to-r from-blue-600 to-brandBlue text-white py-14 px-4 text-center">
      <div class="max-w-3xl mx-auto">
        <span class="bg-white/20 backdrop-blur-md text-white text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider border border-white/30">
          Trải Nghiệm Mua Sắm Chuẩn Style
        </span>
        <h2 class="text-3xl md:text-5xl font-extrabold mt-4 mb-3 tracking-tight">Thế Giới Snack & Ăn Vặt Vyy Lady</h2>
        <p class="text-blue-100 text-base md:text-lg mb-6">Chất lượng cao cấp - Hương vị đậm đà - Giao hàng cực nhanh.</p>
        <a href="#products" class="inline-block bg-white text-brandBlue font-bold px-7 py-3 rounded-full hover:bg-blue-50 transition shadow-md">
          Xem danh mục sản phẩm 👇
        </a>
      </div>
    </section>

    <!-- Main Content / Product Section (Nền Trắng) -->
    <main id="products" class="max-w-6xl mx-auto px-4 py-12 flex-grow">
      <div class="flex items-center justify-between mb-8 border-b border-gray-200 pb-4">
        <h3 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
          <span class="w-2.5 h-6 bg-brandBlue rounded-full inline-block"></span>
          Sản Phẩm Nổi Bật
        </h3>
        <span class="text-sm text-gray-500">Tất cả sản phẩm chính hãng</span>
      </div>

      <!-- Product Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {products.map((item) => (
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg transition-all duration-200 flex flex-col justify-between group">
            <div>
              <!-- Product Image Container -->
              <div class="h-48 bg-slate-50 flex items-center justify-center text-6xl relative group-hover:bg-blue-50/50 transition">
                <span>{item.image}</span>
                {item.tag && (
                  <span class="absolute top-3 left-3 bg-brandBlue text-white font-semibold text-xs px-2.5 py-1 rounded-md shadow-sm">
                    {item.tag}
                  </span>
                )}
              </div>

              <!-- Content -->
              <div class="p-4">
                <span class="text-xs text-brandBlue font-bold uppercase tracking-wider">{item.category}</span>
                <h4 class="font-bold text-gray-800 text-base mt-1 group-hover:text-brandBlue transition line-clamp-2">{item.name}</h4>
                <p class="text-gray-500 text-xs mt-2 line-clamp-2">{item.desc}</p>
              </div>
            </div>

            <!-- Price & Button -->
            <div class="p-4 pt-0">
              <div class="flex items-baseline gap-2 mb-3">
                <span class="text-brandBlue font-extrabold text-xl">
                  {item.price.toLocaleString('vi-VN')}đ
                </span>
                {item.originalPrice && (
                  <span class="text-gray-400 text-xs line-through">
                    {item.originalPrice.toLocaleString('vi-VN')}đ
                  </span>
                )}
              </div>
              <button class="w-full bg-brandBlue hover:bg-brandBlueHover text-white font-semibold py-2.5 px-4 rounded-lg text-sm transition shadow-sm">
                Thêm vào giỏ
              </button>
            </div>
          </div>
        ))}
      </div>
    </main>

    <!-- Footer (Tông Tối / Xanh Đậm Tương Phản) -->
    <footer class="bg-slate-900 text-white mt-12 border-t-2 border-brandBlue">
      <div class="max-w-6xl mx-auto px-4 py-10 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <h4 class="text-xl font-black text-brandBlue mb-2 uppercase">{shopInfo.name}</h4>
          <p class="text-sm text-gray-400 mb-3">{shopInfo.slogan}</p>
          <p class="text-sm text-gray-300">📍 Địa chỉ: {shopInfo.address}</p>
        </div>
        <div>
          <h4 class="text-base font-bold mb-3 text-white">Hỗ Trợ Khách Hàng</h4>
          <p class="text-sm text-gray-300 mb-1">☎️ Hotline: <span class="text-blue-400 font-bold">{shopInfo.hotline}</span></p>
          <p class="text-sm text-gray-300">💬 Zalo: {shopInfo.zalo}</p>
        </div>
        <div>
          <h4 class="text-base font-bold mb-3 text-white">Dịch Vụ & Chính Sách</h4>
          <ul class="text-sm text-gray-400 space-y-1.5">
            <li>• Giao hàng hỏa tốc toàn quốc</li>
            <li>• Kiểm tra hàng trước khi thanh toán</li>
            <li>• Đổi trả trong 7 ngày nếu lỗi sản xuất</li>
          </ul>
        </div>
      </div>
      <div class="bg-slate-950 py-4 text-center text-xs text-gray-500 border-t border-slate-800">
        © 2026 {shopInfo.name}. Bản quyền thuộc về thương hiệu Vyy Lady.
      </div>
    </footer>

  </body>
</html>
