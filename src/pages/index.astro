---
// Import dữ liệu và hàm từ file index.js
import { siteInfo, getFeaturedProducts } from '../data/index.js';

// Chạy hàm lấy danh sách sản phẩm
const products = getFeaturedProducts();
---

<html lang="vi">
  <head>
    <title>{siteInfo.title} - {siteInfo.slogan}</title>
  </head>
  <body>
    <h1>{siteInfo.title}</h1>
    <p>Hotline: {siteInfo.hotline}</p>

    <ul>
      {products.map(item => (
        <li>{item.name} ({item.weight}) - <span>{item.tag}</span></li>
      ))}
    </ul>
  </body>
</html>
