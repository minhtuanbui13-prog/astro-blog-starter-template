  margin: 0; 
  padding: 0; 
  font-family: 'Montserrat', system-ui, -apple-system, sans-serif; 
}
    
    header { background: #ffffff; border-bottom: 1px solid #e2e8f0; position: sticky; top: 0; z-index: 50; }
    .header-container { max-width: 1100px; margin: 0 auto; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; }
    .logo { color: #0066ff; font-size: 22px; font-weight: 900; text-transform: uppercase; text-decoration: none; }
    .back-home { font-size: 14px; color: #64748b; text-decoration: none; font-weight: 600; }
    .back-home:hover { color: #0066ff; }

    main { max-width: 900px; margin: 40px auto; padding: 0 16px; flex-grow: 1; width: 100%; }
    
    .product-detail-container { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; margin-bottom: 50px; }
    @media (max-width: 768px) { .product-detail-container { grid-template-columns: 1fr; } }

    .product-img-wrap { 
  width: 100%; 
  aspect-ratio: 1 / 1; 
  background: #f8fafc; 
  border-radius: 12px; 
  overflow: hidden; 
  display: flex; 
  align-items: center;    /* Căn giữa theo chiều dọc (tạo lề trên và dưới đều nhau) */
  justify-content: center; /* Căn giữa theo chiều ngang */
  padding: 20px;           /* Tạo khoảng đệm (lề) xung quanh ảnh */
  border: 1px solid #e2e8f0; 
}

.product-img { 
  max-width: 100%;       /* Giữ kích thước tối đa vừa vặn với khung */
  max-height: 100%;      /* Đảm bảo ảnh không bị tràn lề trên/dưới */
  object-fit: contain;   /* Giữ nguyên tỷ lệ chuẩn của ảnh, không bị méo hình */
}

    .product-info { display: flex; flex-direction: column; gap: 16px; }
    .category { font-size: 13px; font-weight: 700; color: #0066ff; text-transform: uppercase; }
    .title { font-size: 24px; font-weight: 800; color: #0f172a; line-height: 1.3; }
    
    .price-box { display: flex; align-items: baseline; gap: 12px; background: #f1f5f9; padding: 12px 16px; border-radius: 8px; }
    .price { font-size: 24px; font-weight: 800; color: #0066ff; }
    .original-price { font-size: 14px; color: #94a3b8; text-decoration: line-through; }

    .desc { font-size: 15px; color: #475569; line-height: 1.6; }
    .detail-box { font-size: 14px; color: #334155; line-height: 1.6; border-top: 1px solid #e2e8f0; padding-top: 12px; }

    .btn-zalo { background: #0066ff; color: white; text-align: center; padding: 14px; border-radius: 8px; font-weight: 700; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background 0.2s; margin-top: 8px; }
    .btn-zalo:hover { background: #0052cc; }

    /* Phần Sản phẩm tương tự */
    .section-title { font-size: 20px; font-weight: 800; margin-bottom: 20px; color: #0f172a; border-left: 4px solid #0066ff; padding-left: 10px; }
.related-grid { 
  display: grid; 
  grid-template-columns: repeat(2, 1fr); /* Đổi sang hiển thị 2 cột to bản trên máy tính hoặc tùy chỉnh */
  gap: 20px; 
}
@media (min-width: 768px) {
  .related-grid { 
    grid-template-columns: repeat(4, 1fr); /* Vẫn giữ 4 cột nhưng mở rộng không gian cho mỗi card */
  }
}

.card { 
  background: #ffffff; 
  border: 1px solid #e2e8f0; 
  border-radius: 16px; 
  padding: 16px; /* Tăng padding của khung thẻ để card trông to và dày dặn hơn */
  display: flex; 
  flex-direction: column; 
  justify-content: space-between; 
  text-decoration: none; 
  color: inherit; 
  transition: transform 0.2s, box-shadow 0.2s; 
}

.card:hover { 
  transform: translateY(-4px); 
  box-shadow: 0 12px 24px rgba(0,0,0,0.08); 
}

.card-img-wrap { 
  width: 100%; 
  aspect-ratio: 1 / 1; /* Giữ khung hình vuông chuẩn */
  background: #f8fafc; 
  border-radius: 12px; 
  overflow: hidden; 
  display: flex; 
  align-items: center;    
  justify-content: center; 
  padding: 16px; /* Tăng khoảng đệm để ảnh bên trong vừa vặn, không bị sát viền */
  margin-bottom: 14px; 
  border: 1px solid #f1f5f9;
}

.card-img { 
  max-width: 100%;       
  max-height: 100%;      
  object-fit: contain;   /* Giữ tỷ lệ ảnh chuẩn, không bị méo */
  transition: transform 0.3s ease;
}

.card:hover .card-img {
  transform: scale(1.05); /* Hiệu ứng phóng to nhẹ khi rê chuột vào ảnh */
}
    .card-title { font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 6px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .card-price { font-size: 15px; font-weight: 800; color: #0066ff; }

    footer { background: #0f172a; color: white; margin-top: 40px; border-top: 3px solid #0066ff; text-align: center; padding: 20px; font-size: 13px; color: #94a3b8; }
  </style>
</head>
<body>

  <header>
    <div class="header-container">
      <a href="/" class="logo">{shopInfo.name}</a>
      <a href="/" class="back-home">← Quay lại trang chủ</a>
    </div>
  </header>

  <main>
    <!-- Thông tin chi tiết sản phẩm chính -->
    <div class="product-detail-container">
      <div class="product-img-wrap">
        <img src={product.image} alt={product.name} class="product-img" />
      </div>
      
      <div class="product-info">
        <div>
          <span class="category">{product.category}</span>
          <h1 class="title">{product.name}</h1>
        </div>

        <div class="price-box">
          <span class="price">{product.price.toLocaleString('vi-VN')}đ</span>
          {product.originalPrice && <span class="original-price">{product.originalPrice.toLocaleString('vi-VN')}đ</span>}
        </div>

        <p class="desc"><strong>Mô tả ngắn:</strong> {product.desc}</p>
        
        <div class="detail-box">
          <p><strong>Chi tiết sản phẩm:</strong> {product.detail}</p>
        </div>

        <a href={`https://zalo.me/${shopInfo.zalo}`} target="_blank" rel="noopener noreferrer" class="btn-zalo">
          💬 Liên hệ tư vấn qua Zalo ({shopInfo.zalo})
        </a>
      </div>
    </div>

    <!-- Danh sách sản phẩm tương tự -->
    <div class="related-section">
      <h3 class="section-title">Sản phẩm tương tự</h3>
      <div class="related-grid">
        {relatedProducts.map((item) => (
          <a href={`/san-pham/${item.slug}`} class="card">
            <div>
              <div class="card-img-wrap">
                <img src={item.image} alt={item.name} class="card-img" loading="lazy" />
              </div>
              <div class="card-title">{item.name}</div>
            </div>
            <div class="card-price">{item.price.toLocaleString('vi-VN')}đ</div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <footer>
    © {new Date().getFullYear()} {shopInfo.name} - Hotline: {shopInfo.hotline}
  </footer>

</body>
</html>
