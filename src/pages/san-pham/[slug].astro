const { product } = Astro.props;
const shopInfo = {
  name: "Vyy Lady Store",
  slogan: "Snack Your Style, Chill Your Way",
  hotline: "1900 8280",
  zalo: "0896443368",
  address: "622 Minh Khai, Hai Bà Trưng, Hà Nội"
};

const relatedProducts = products.filter(p => p.slug !== product.slug).slice(0, 4);
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{product.name} - {shopInfo.name}</title>
  <link rel="icon" type="image/png" href="https://6a9697843db6a220b86461d0.imgix.net/sandbox/favicon-tbn.png" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { 
      box-sizing: border-box; 
      margin: 0; 
      padding: 0; 
      font-family: 'Montserrat', system-ui, -apple-system, sans-serif; 
    }
    
    body {
      background-color: #f8fafc;
      color: #0f172a;
      line-height: 1.5;
    }

    header { background: #ffffff; border-bottom: 1px solid #e2e8f0; position: sticky; top: 0; z-index: 50; }
    .header-container { max-width: 1000px; margin: 0 auto; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; }
    .logo { color: #0066ff; font-size: 20px; font-weight: 900; text-transform: uppercase; text-decoration: none; }
    .back-home { font-size: 14px; color: #64748b; text-decoration: none; font-weight: 600; }
    .back-home:hover { color: #0066ff; }

    main { max-width: 1000px; margin: 30px auto; padding: 0 16px; width: 100%; }
    
    /* FIX CHI TIẾT SẢN PHẨM CHÍNH */
    .product-detail-container { 
      background: #ffffff; 
      border: 1px solid #e2e8f0; 
      border-radius: 16px; 
      padding: 24px; 
      display: flex; 
      flex-direction: column; 
      gap: 24px; 
      margin-bottom: 40px; 
    }

    @media (min-width: 768px) {
      .product-detail-container { 
        display: grid; 
        grid-template-columns: 320px 1fr; 
        gap: 32px; 
        align-items: start;
      }
    }

    .product-img-wrap { 
      width: 100%; 
      height: 320px; 
      background: #f8fafc; 
      border-radius: 12px; 
      overflow: hidden; 
      display: flex; 
      align-items: center;    
      justify-content: center; 
      padding: 16px;           
      border: 1px solid #e2e8f0; 
    }

    .product-img { 
      max-width: 100%;       
      max-height: 100%;      
      width: auto;
      height: auto;
      object-fit: contain;   
      display: block;
    }

    .product-info { display: flex; flex-direction: column; gap: 14px; }
    .category { font-size: 12px; font-weight: 700; color: #0066ff; text-transform: uppercase; letter-spacing: 0.5px; }
    .title { font-size: 22px; font-weight: 800; color: #0f172a; line-height: 1.3; }
    
    .price-box { display: flex; align-items: baseline; gap: 12px; background: #f1f5f9; padding: 10px 14px; border-radius: 8px; width: fit-content; }
    .price { font-size: 22px; font-weight: 800; color: #0066ff; }
    .original-price { font-size: 14px; color: #94a3b8; text-decoration: line-through; }

    .desc { font-size: 14px; color: #475569; line-height: 1.5; }
    .detail-box { font-size: 13px; color: #334155; line-height: 1.6; border-top: 1px solid #e2e8f0; padding-top: 12px; }

    .btn-zalo { background: #0066ff; color: white; text-align: center; padding: 12px; border-radius: 8px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; transition: background 0.2s; margin-top: 6px; font-size: 14px; }
    .btn-zalo:hover { background: #0052cc; }

    /* FIX SẢN PHẨM TƯƠNG TỰ - CHỐNG VỠ HOÀN TOÀN */
    .section-title { font-size: 18px; font-weight: 800; margin-bottom: 16px; color: #0f172a; border-left: 4px solid #0066ff; padding-left: 10px; }
    
    .related-grid { 
      display: grid; 
      grid-template-columns: repeat(2, 1fr); 
      gap: 16px; 
      width: 100%;
    }

    @media (min-width: 768px) {
      .related-grid { 
        grid-template-columns: repeat(4, 1fr); 
      }
    }

    .card { 
      background: #ffffff; 
      border: 1px solid #e2e8f0; 
      border-radius: 12px; 
      padding: 12px; 
      display: flex; 
      flex-direction: column; 
      justify-content: space-between; 
      text-decoration: none; 
      color: inherit; 
      transition: transform 0.2s, box-shadow 0.2s;
      min-width: 0; /* CHỐNG VỠ GRID */
      overflow: hidden;
    }

    .card:hover { 
      transform: translateY(-4px); 
      box-shadow: 0 8px 16px rgba(0,0,0,0.06); 
    }

    .card-img-wrap { 
      width: 100%; 
      height: 150px; /* KHÓA CHIỀU CAO CỐ ĐỊNH */
      background: #f8fafc; 
      border-radius: 8px; 
      overflow: hidden; 
      display: flex; 
      align-items: center;    
      justify-content: center; 
      padding: 8px; 
      margin-bottom: 10px; 
      border: 1px solid #f1f5f9;
    }

    .card-img { 
      max-width: 100% !important;
      max-height: 100% !important;
      width: auto !important;
      height: auto !important;
      object-fit: contain !important; /* GIỮ TỶ LỆ Chuẩn */
      display: block;
    }

    .card-title { 
      font-size: 13px; 
      font-weight: 700; 
      color: #0f172a; 
      margin-bottom: 4px; 
      line-height: 1.4;
      display: -webkit-box; 
      -webkit-line-clamp: 2; 
      -webkit-box-orient: vertical; 
      overflow: hidden; 
      height: 2.8em;
    }

    .card-price { 
      font-size: 14px; 
      font-weight: 800; 
      color: #0066ff; 
      margin-top: 4px;
    }

    footer { background: #0f172a; color: white; margin-top: 40px; border-top: 3px solid #0066ff; text-align: center; padding: 20px; font-size: 13px; color: #94a3b8; }
  </style>
</head>
<body>

  <header>
    <div class="header-container">
      <a href="/" class="logo">{shopInfo.name}</a>
      <a href="/" class="back-home">← Quay lại trang chủ</a>
    </div>
  </header>

  <main>
    <div class="product-detail-container">
      <div class="product-img-wrap">
        <img src={product.image} alt={product.name} class="product-img" />
      </div>
      
      <div class="product-info">
        <div>
          <span class="category">{product.category}</span>
          <h1 class="title">{product.name}</h1>
        </div>

        <div class="price-box">
          <span class="price">{product.price.toLocaleString('vi-VN')}đ</span>
          {product.originalPrice && <span class="original-price">{product.originalPrice.toLocaleString('vi-VN')}đ</span>}
        </div>

        <p class="desc"><strong>Mô tả ngắn:</strong> {product.desc}</p>
        
        <div class="detail-box">
          <p><strong>Chi tiết sản phẩm:</strong> {product.detail}</p>
        </div>

        <a href={`https://zalo.me/${shopInfo.zalo}`} target="_blank" rel="noopener noreferrer" class="btn-zalo">
          💬 Liên hệ tư vấn qua Zalo ({shopInfo.zalo})
        </a>
      </div>
    </div>

    <div class="related-section">
      <h3 class="section-title">Sản phẩm tương tự</h3>
      <div class="related-grid">
        {relatedProducts.map((item) => (
          <a href={`/san-pham/${item.slug}`} class="card">
            <div>
              <div class="card-img-wrap">
                <img src={item.image} alt={item.name} class="card-img" loading="lazy" />
              </div>
              <div class="card-title">{item.name}</div>
            </div>
            <div class="card-price">{item.price.toLocaleString('vi-VN')}đ</div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <footer>
    © {new Date().getFullYear()} {shopInfo.name} - Hotline: {shopInfo.hotline}
  </footer>

</body>
</html>
